pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building...'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
            }
        }
    }

    post {
        success {
            office365ConnectorSend message: 'Build Succeeded!', webhookUrl: 'https://outlook.office.com/webhook/...'
        }
        failure {
            office365ConnectorSend message: 'Build Failed!', webhookUrl: 'https://outlook.office.com/webhook/...'
        }
    }
}
